# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~

# Claude Code per-user state
.claude/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.python-version
*.egg-info/
build/
dist/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type / lint caches
.mypy_cache/
.ruff_cache/
.pyright/

# State directories during development
state/
*.tmp
.tmp/

# NAS emulator (tests/docker/) — keep the layout, ignore generated state
tests/docker/nas-data/*
!tests/docker/nas-data/.gitkeep

# Local secrets / env (never commit)
.env
.env.*
# ...but the committed templates carry no secrets.
!.env.example
!tests/docker/.env.example
*.secret

# pre-commit cache
.pre-commit-cache/

# PyInstaller
*.spec.bak

# Local agent artifacts
.claude-agent-output/
.playwright-mcp/

# superpowers brainstorming visual companion
.superpowers/
graphify-out/
